<?xml version="1.0" encoding="UTF-8"?>
<!--
================================================================================
  sitemap.xml для {{SITE_DOMAIN}}
  Кладётся в корень: {{SITE_URL}}/sitemap.xml
  Указан в robots.txt последней строкой.
================================================================================

  ЧТО ЗДЕСЬ ЕСТЬ (27 адресов):
    1  главная
    3  хаба услуг
    12 городских страниц
    1  список статей /blog/
    9  статей блога
    1  политика конфиденциальности

  ЧЕГО ЗДЕСЬ НЕТ И БЫТЬ НЕ ДОЛЖНО:
    /spasibo/  — закрыта через <meta name="robots" content="noindex">.
                 Страница с noindex в sitemap — прямое противоречие:
                 вы одновременно просите её проиндексировать и не индексировать.
                 Яндекс.Вебмастер отдельно ругается на это в разделе
                 «Страницы в поиске → Исключённые».
    404        — по определению не индексируется.

  ==========================================================================
  ПРО lastmod, changefreq И priority

    lastmod     — единственное поле, которое реально используется.
                  Формат W3C Datetime: ГГГГ-ММ-ДД (можно с временем и зоной).
                  ⚠️ Ставьте ЧЕСТНУЮ дату последнего изменения страницы.
                  Массовая простановка «сегодня» на всех URL при каждой
                  выгрузке — известный способ обесценить сигнал: поисковик
                  перестаёт ему доверять и начинает игнорировать.

    changefreq  — Google игнорирует полностью. Яндекс учитывает как слабую
                  подсказку. Оставлены для полноты, вреда не несут.

    priority    — Google игнорирует с 2023 года. Задаёт относительный вес
                  внутри вашего же сайта, а не позицию в выдаче.
                  1.0 у всех страниц = то же самое, что 0.5 у всех.

  ==========================================================================
  КОГДА ПОНАДОБИТСЯ ИНДЕКСНЫЙ SITEMAP

  Один файл вмещает 50 000 URL и 50 МБ в несжатом виде — вам до этого далеко.
  Разбивать на /sitemap-pages.xml + /sitemap-blog.xml имеет смысл раньше,
  и только ради удобства: в Вебмастере видно, сколько страниц из каждой
  группы попало в индекс. Тогда в robots.txt указывается индексный файл:

    <?xml version="1.0" encoding="UTF-8"?>
    <sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
      <sitemap><loc>{{SITE_URL}}/sitemap-pages.xml</loc></sitemap>
      <sitemap><loc>{{SITE_URL}}/sitemap-blog.xml</loc></sitemap>
    </sitemapindex>

  ==========================================================================
  ЗАГЛУШКИ ПЕРЕД ПУБЛИКАЦИЕЙ:
    1. Заменить {{SITE_URL}} на реальный адрес с https и без слеша на конце
    2. Проставить реальные даты вместо {{LASTMOD_*}}
    3. Выверить список статей — в примере 9 штук из шаблона /blog/
    4. Добавить sitemap в Яндекс.Вебмастер и Google Search Console

  ПОДДЕРЖИВАТЬ ВРУЧНУЮ НЕУДОБНО. Рядом лежит tools/build-sitemap.py —
  генерирует этот файл из списка страниц одной командой.
================================================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- ============================== ГЛАВНАЯ ============================== -->
  <url>
    <loc>{{SITE_URL}}/</loc>
