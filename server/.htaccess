# ============================================================================
#  Защита файлов обработчика форм (Apache)
#  Кладётся в ту же папку, где лежат config.php и logs/ — то есть в корень
#  сайта, если вы не вынесли их выше.
#
#  ⚠️ БЕЗ ЭТОГО ФАЙЛА любой желающий откроет
#      https://ваш-сайт.ru/logs/leads.csv
#  и скачает все заявки с именами и телефонами. Это утечка персональных
#  данных со всеми вытекающими по 152-ФЗ.
#
#  ПРОВЕРЬТЕ ПОСЛЕ ЗАЛИВКИ — обе команды должны вернуть 403:
#      curl -I https://ваш-сайт.ru/config.php
#      curl -I https://ваш-сайт.ru/logs/leads.csv
# ============================================================================

# Настройки с токеном бота
<Files "config.php">
    Require all denied
</Files>
<Files "config.sample.php">
    Require all denied
</Files>

# Логи и выгрузки заявок
<FilesMatch "\.(csv|log)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/logs/
